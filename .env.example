# Copy to .env and edit
DOMAIN=e440.example.com
# Name of the docker network your Traefik container is on
#   (find it with: docker inspect traefik --format '{{json .NetworkSettings.Networks}}')
TRAEFIK_NETWORK=traefik
# Traefik entrypoint name (e.g. web for :80, websecure for :443)
TRAEFIK_ENTRYPOINT=web
# TRAEFIK_CERTRESOLVER=letsencrypt
